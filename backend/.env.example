NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL: either set DATABASE_URL or the individual PG_* values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulse
PGSSL=false
PGHOST=localhost
PGPORT=5432
PGDATABASE=pulse
PGUSER=postgres
PGPASSWORD=postgres

# Hedera operator credentials.
HEDERA_NETWORK=testnet
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_OPERATOR_ID=0.0.12345
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420REPLACE_WITH_TESTNET_KEY
HEDERA_TOKEN_DECIMALS=8
HEDERA_DEFAULT_TOKEN_SUPPLY=0
HEDERA_TOKEN_CREATION_FEE_HBAR=20

# Shared bonding-curve contract deployed address (optional until deployment).
PULSE_MARKET_FACTORY_ADDRESS=
PULSE_BONDING_CURVE_ADDRESS=

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_ISSUER=pulse-api

DEFAULT_PROTOCOL_FEE_BPS=100
DEFAULT_MAX_SUPPLY=1000000
TRANSACTION_DEADLINE_SECONDS=300